{
    "display_information": {
        "name": "Dill",
        "description": "When you don't have time to pickle",
        "background_color": "#575757"
    },
    "features": {
        "app_home": {
            "home_tab_enabled": false,
            "messages_tab_enabled": true,
            "messages_tab_read_only_enabled": false
        },
        "bot_user": {
            "display_name": "Dill",
            "always_online": true
        },
        "slash_commands": [
            {
                "command": "/dill",
                "description": "Start the round-robin pick",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "channels:join",
                "channels:read",
                "channels:history",
                "chat:write",
                "chat:write.public",
                "commands",
                "groups:read",
                "groups:write",
                "groups:history",
                "users:read",
                "reactions:read"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "event_subscriptions": {
            "bot_events": [
                "reaction_added",
                "reaction_removed"
            ]
        },
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "is_mcp_enabled": false,
        "token_rotation_enabled": false,
        "app_level_token_rotation_enabled": false
    }
}
